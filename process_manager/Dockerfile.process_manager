FROM ros:humble-ros-base AS ros2_ws_builder

ENV ROS_DISTRO=humble
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /ros2_ws

COPY basestationproject/ros2_ws/src ./src

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        python3-colcon-common-extensions \
        python3-pip \
        python3-rosdep && \
    rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y && \
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build --symlink-install && \
    rm -rf /var/lib/apt/lists/*

FROM ros:humble-ros-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ROS_DISTRO=humble

WORKDIR /workspace

COPY --from=ros2_ws_builder /ros2_ws /ros2_ws

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-pip python3-dev python3-venv \
        ffmpeg libsm6 libxext6 libgl1 \
        ros-${ROS_DISTRO}-cv-bridge && \
    ln -s /usr/bin/python3 /usr/local/bin/python || true && \
    mkdir -p /workspace/basestationproject && \
    (ln -s /ros2_ws /workspace/basestationproject/ros2_ws || true) && \
    rm -rf /var/lib/apt/lists/*

COPY process_manager ./process_manager
COPY robot_controller ./robot_controller

RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --ignore-installed --no-cache-dir \
        "fastapi==0.115.6" \
        "uvicorn[standard]==0.34.0" \
        "starlette==0.41.3" \
        "python-multipart==0.0.20" \
        "aiofiles==24.1.0" \
        "opencv-python"

WORKDIR /workspace/process_manager

EXPOSE 8081

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8081", "--reload"]
