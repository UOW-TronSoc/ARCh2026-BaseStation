[Unit]
Description=Basestation frontend (Vite dev server)
After=network.target

[Service]
Type=simple
User=kanga
WorkingDirectory=/home/kanga/kanga/basestation/basestationproject/frontend
ExecStart=/home/kanga/kanga/basestation/basestationproject/scripts/run_npm_dev.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=CI=1

[Install]
WantedBy=multi-user.target
